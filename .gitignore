node_modules/
dist/
.qa/
*.local
.DS_Store
*.log
.env
.env.*

# Browser-run output (screenshots, APKs, install logs) is regenerated by the
# harnesses in .qa/ — evidence, not source.
artifacts/

# Release signing material — never commit these.
android/keystore.properties
*.jks
*.keystore
*.p12
*.mobileprovision

# Play upload binaries are rebuilt; keep the listing, graphics and policy in git.
store/*.aab
store/source/

# Google Play service-account keys — tools/play-publish.mjs looks for one here.
# Whatever the name, a key file must never enter history.
store/play-service-account*.json

# Capacitor copies the web build into both native projects on every sync.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml
android/.gradle/
android/build/
android/app/build/
android/local.properties
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/App/config.xml
ios/App/Pods/
ios/App/build/
ios/App/output/
ios/DerivedData/
xcuserdata/
/freebuff-sites-build/
