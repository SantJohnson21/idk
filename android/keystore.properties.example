# Release signing for the Play Store build.
#
#   1. Copy this file to android/keystore.properties (gitignored).
#   2. Create the upload key (keep the .jks out of git and back it up):
#
#      keytool -genkeypair -v \
#        -keystore android/rewind-bowl-upload.jks \
#        -alias rewind-bowl \
#        -keyalg RSA -keysize 4096 -validity 10000
#
#   3. Fill in the four values below, using `storeFile` relative to android/.
#   4. npm run mobile:aab
#
# If this file is absent, `assembleRelease` still runs but produces an unsigned
# artifact, which Play will reject. Never commit a real keystore or password.

storeFile=rewind-bowl-upload.jks
storePassword=CHANGE_ME
keyAlias=rewind-bowl
keyPassword=CHANGE_ME
